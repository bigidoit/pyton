import sys
import requests
from PyQt5.QtWidgets import QApplication, QWidget, QLabel, QLineEdit, QPushButton, QVBoxLayout
from PyQt5.QtGui import QPixmap, QImage
from PyQt5.QtCore import Qt

class Country(QWidget):
    EMOJIS = {
        "North America": "🌎",
        "South America": "🌎",
        "Asia": "🌏",
        "Europe": "🌍",
        "Oceania": "🌏",
        "Africa": "🌍",
        "Antarctica": "❄️"
    }

    def __init__(self):
        super().__init__()

        self.widgets = {}

        self.widgets["country_label"] = QLabel("Country", self)
        self.widgets["country_input"] = QLineEdit(self)
        self.widgets["get_info_button"] = QPushButton("Get Info", self)
        self.widgets["capital_label"] = QLabel("Capital", self)
        self.widgets["continent_label"] = QLabel("Continent", self)
        self.widgets["emoji_label"] = QLabel("🌎", self)
        self.widgets["flag_label"] = QLabel(self)

        self.widgets["country_input"].setPlaceholderText("Enter country name")

        self.initUI()

    def initUI(self):
        self.setWindowTitle("Weather")

        self.vbox = QVBoxLayout()
        
        for name, widget in self.widgets.items():
            self.vbox.addWidget(widget)

            widget.setObjectName(name)

            if type(widget) != QPushButton:
                widget.setAlignment(Qt.AlignCenter)

        self.setLayout(self.vbox)

        self.setStyleSheet("""
            QLabel, QPushButton{
                font-family: Times;
            }
            QLabel#country_label{
                font-size: 40px;
                font-style: italic;
            }
            QLineEdit#country_input{
                font-size: 40px;
            }
            QPushButton#get_info_button{
                font-size: 30px;
                font-weight: bold;
            }
            QLabel#capital_label{
                font-size: 75px;
            }
            QLabel#continent_label{
                font-size: 50px;
            }
            QLabel#emoji_label{
                font-size: 100px;
                font-family: Segoe UI Emoji;
            }
        """)

        self.widgets["get_info_button"].clicked.connect(self.get_info)

    def get_info(self):
        country = self.widgets["country_input"].text()
        url = f"https://restcountries.com/v3.1/name/{country}?fullText=true"

        try:
            response = requests.get(url)
            response.raise_for_status()

            data = response.json()
               
            if response.status_code == 200:
                self.update_display(data)
        except requests.exceptions.HTTPError:
            self.display_error(f"Error: {response.status_code}")
        except requests.exceptions.ConnectionError:
            self.display_error("Connection Error")
        except requests.exceptions.Timeout:
            self.display_error("Timeout Error")
        except requests.exceptions.TooManyRedirects:
            self.display_error("Too Many Redirects")
        except requests.exceptions.RequestException as reqError:
            self.display_error(f"Request Error: {reqError}")

    def display_error(self, message):
        self.widgets["capital_label"].setStyleSheet("font-size: 30px;")

        for name, widget in self.widgets.items():
            if type(widget) == QLabel and widget != self.widgets["country_label"]:
                widget.clear()

        self.widgets["capital_label"].setText(message)

    def update_display(self, data):
        info = data[0]

        country = info["name"]["official"]
        capital = info["capital"][0]
        continent = info["region"]
        flag_png = info["flags"]["png"]

        subregion = info["subregion"]
        
        self.widgets["country_label"].setText(country)
        self.widgets["capital_label"].setText(f"Capital: {capital}")
        self.widgets["continent_label"].setText(f"Continent: {continent}")

        if subregion in self.EMOJIS:
            self.widgets["emoji_label"].setText(self.EMOJIS[subregion])
        else:
            self.widgets["emoji_label"].setText(self.EMOJIS[continent])

        self.load_flag_image(flag_png)

    def load_flag_image(self, url):
        try:
            response = requests.get(url)
            response.raise_for_status()

            image_data = response.content

            pixmap = QPixmap()

            if pixmap.loadFromData(image_data):
                self.widgets["flag_label"].setPixmap(pixmap)
            else:
                self.widgets["flag_label"].setText("Failed to load flag")
        except requests.exceptions.RequestException as err:
            self.widgets["flag_label"].setText(f"Failed to load flag: Network error - {err}")
        except Exception as err:
           self.widgets["flag_label"].setText(f"Failed to load flag: {err}")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    country = Country()
    country.show()
    sys.exit(app.exec_())
